#!/usr/bin/env python3
"""Reject commits whose subject is not a conventional commit.

Accepted forms: "type(scope): subject" or "type: subject", where type is an
allowed type and the whole subject is at most 72 characters.
"""
import re
import sys

ALLOWED_TYPES = ("feat", "fix", "docs", "refactor", "test", "chore")
MAX_SUBJECT_LENGTH = 72

SUBJECT_PATTERN = re.compile(
    rf"(?:{'|'.join(ALLOWED_TYPES)})(?:\([^()\s]+\))?: \S.*"
)
# "git commit -v" places the diff below this line; git discards it all.
SCISSORS_PATTERN = re.compile(r"# -+ >8 -+")


def extract_subject(message: str) -> str:
    """Return the subject as git sees it: the first paragraph, on one line."""
    subject_lines: list[str] = []
    for line in message.split("\n"):
        line = line.rstrip()
        if SCISSORS_PATTERN.fullmatch(line):
            break
        if line.startswith("#"):
            continue
        if line:
            subject_lines.append(line)
        elif subject_lines:
            break
    return " ".join(subject_lines)


def main() -> int:
    with open(sys.argv[1], encoding="utf-8", errors="replace") as message_file:
        subject = extract_subject(message_file.read())

    errors: list[str] = []
    if not SUBJECT_PATTERN.fullmatch(subject):
        errors.append(
            "subject must be 'type(scope): subject' or 'type: subject', "
            f"where type is one of: {', '.join(ALLOWED_TYPES)}"
        )
    if len(subject) > MAX_SUBJECT_LENGTH:
        errors.append(
            f"subject is {len(subject)} characters; "
            f"the maximum is {MAX_SUBJECT_LENGTH}"
        )

    if errors:
        print(f"commit-msg: rejected subject: {subject!r}", file=sys.stderr)
        for error in errors:
            print(f"  - {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
